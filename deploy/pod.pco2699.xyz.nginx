# pod.pco2699.xyz — pod-server (127.0.0.1:8094) checks the key on /api.
# Install: sudo cp to /etc/nginx/sites-available/, symlink into sites-enabled,
# then `sudo certbot --nginx -d pod.pco2699.xyz` adds the TLS blocks.
server {
    server_name pod.pco2699.xyz;
    listen 80;
    listen [::]:80;

    # ?key= must not end up in the access log.
    access_log /var/log/nginx/pod.access.log note_noquery;
    error_log  /var/log/nginx/pod.error.log;

    gzip on;
    gzip_proxied any;
    gzip_types application/wasm application/javascript application/json text/css;

    # Uploads arrive in 8 MiB chunks.
    client_max_body_size 16m;

    location / {
        proxy_pass http://127.0.0.1:8094;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        # Stream large WAV downloads instead of spooling them to disk first.
        proxy_max_temp_file_size 0;
        proxy_read_timeout 300s;
    }
}
